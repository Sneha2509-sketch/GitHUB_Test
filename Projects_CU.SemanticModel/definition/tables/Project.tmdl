	column 'Aging Group' =
			
			SWITCH(TRUE(),
			project[Age] >=0 && project[Age] <=30,30,
			project[Age] >30 && project[Age] <=60,60,
			project[Age] >60 && project[Age] <=90,90,
			BLANK()
			)
