table Project
	lineageTag: 9406ec64-21d6-4e07-980d-6fb44f180d70
	sourceLineageTag: [dbo].[Project]

	measure 'Total Projects' =
			
			COUNTROWS('Project')
		formatString: 0
		lineageTag: 030d8157-d03c-4af2-b24a-0b8d7d2946f0

		changedProperty = Name

	measure 'Project NonInvoicedRevenue' =
			
			VAR revenue_USD =
			    CALCULATE (
			        SUMX (
			            Project,
			            DIVIDE (Project[non_invoiced_revenue] , RELATED ( 'Currency'[exchange_rate] ), 0 )
			        )
			    )
			VAR exchange_rate =
			    SELECTEDVALUE ( 'destination_currency'[exchange_rate] )
			RETURN
			    exchange_rate * revenue_USD
		lineageTag: 6b440586-2aa3-4032-b875-148bdc0a6a0e

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure 'Project Revenue' =
			
			VAR revenue_USD =
			    CALCULATE (
			        SUMX (
			            Project,
			            DIVIDE (Project[amount_revenue] , RELATED ( 'Currency'[exchange_rate] ), 0 )
			        )
			    )
			VAR exchange_rate =
			    SELECTEDVALUE ( 'destination_currency'[exchange_rate] )
			RETURN
			    exchange_rate * revenue_USD
		lineageTag: b7b4c8b1-d055-4498-a4d9-13ecfe763065

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure Revenue_30Days = ```
			
			VAR SelectedExchangeRate = SELECTEDVALUE('destination_currency'[exchange_rate], 1)
			RETURN
			    CALCULATE(
			        SUMX(
			            'project',
			            DIVIDE('project'[amount_revenue], RELATED('Currency'[exchange_rate]), 0)
			        ) * SelectedExchangeRate,
			        FILTER(
			            'project',
			            DATEDIFF(TODAY(), 'project'[date_promised_complete], DAY) <= 30
			                && DATEDIFF(TODAY(), 'project'[date_promised_complete], DAY) >= 0
			        )
			    )
			
			```
		lineageTag: f7a6fc6d-82fe-4b20-8388-2223c66d920c

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure Revenue_60Days =
			
			VAR SelectedExchangeRate = SELECTEDVALUE('destination_currency'[exchange_rate], 1)
			RETURN
			    CALCULATE(
			        SUMX(
			            'project',
			            DIVIDE('project'[amount_revenue], RELATED('Currency'[exchange_rate]), 0)
			        ) * SelectedExchangeRate,
			        FILTER(
			            'project',
			            DATEDIFF(TODAY(), 'project'[date_promised_complete], DAY) <= 60
			                && DATEDIFF(TODAY(), 'project'[date_promised_complete], DAY) > 30
			        )
			    )
		lineageTag: 5006af02-669f-4668-9f4a-7b8b0108318e

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure Revenue_90Days =
			
			VAR SelectedExchangeRate = SELECTEDVALUE('destination_currency'[exchange_rate], 1)
			RETURN
			    CALCULATE(
			        SUMX(
			            'project',
			            DIVIDE('project'[amount_revenue], RELATED('Currency'[exchange_rate]), 0)
			        ) * SelectedExchangeRate,
			        FILTER(
			            'project',
			            DATEDIFF(TODAY(), 'project'[date_promised_complete], DAY) <= 90
			                && DATEDIFF(TODAY(), 'project'[date_promised_complete], DAY) > 60
			        )
			    )
		lineageTag: f50ec66a-5803-4e55-b62e-f6338fa6031e

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure 'Running Total of Project Revenue' =
			
			VAR MaxDate = MAX('project'[date_promised_complete])
			RETURN
			SUMX(
			    FILTER(
			        ALLSELECTED('project'),
			        'project'[date_promised_complete] <= MaxDate
			    ),
			    DIVIDE(
			        'project'[amount_revenue],
			        RELATED('Currency'[exchange_rate]),
			        0
			    )
			) * SELECTEDVALUE('destination_currency'[exchange_rate])
		lineageTag: 840b7989-47aa-4f26-a9f6-6e4d5e129a50

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure 'Total Invoiced Revenue' =
			
			VAR invoiced_USD =
			    CALCULATE(
			        SUMX(
			            'project',
			            DIVIDE('project'[invoiced_revenue], RELATED('Currency'[exchange_rate]), 0)
			        ),
			        'project'[invoiced_revenue] > 0
			    )
			VAR destination_rate = SELECTEDVALUE('destination_currency'[exchange_rate], 1)
			RETURN
			    invoiced_USD * destination_rate
		lineageTag: dfdb8d36-1f59-4813-8a63-c59269bc1aad

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure 'Total Non-Invoiced Revenue' =
			
			VAR noninvoiced_USD =
			    CALCULATE(
			        SUMX(
			            'Project',
			            DIVIDE('project'[non_invoiced_revenue], RELATED('Currency'[exchange_rate]), 0)
			        ),
			        'project'[non_invoiced_revenue] > 0
			    )
			VAR destination_rate = SELECTEDVALUE('destination_currency'[exchange_rate], 1)
			RETURN
			    noninvoiced_USD * destination_rate
		lineageTag: 63c3b2dd-c80e-4381-a6a5-b92229ee3e5f

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure 'Total Unallocated Revenue' =
			
			VAR unallocated_USD =
			    CALCULATE(
			        SUMX(
			            'project',
			            DIVIDE('project'[unallocated_revenue], RELATED('Currency'[exchange_rate]), 0)
			        ),
			        'project'[unallocated_revenue] > 0
			    )
			VAR destination_rate = SELECTEDVALUE('destination_currency'[exchange_rate], 1)
			RETURN
			    unallocated_USD * destination_rate
		lineageTag: 80fd2c14-4824-4624-8186-af1948efd0d2

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure 'Projects Using Calendar' = ```
			
			COUNTROWS(
			    RELATEDTABLE(Project)
			)
			
			```
		formatString: 0
		lineageTag: 0bd51db9-355a-40ae-a48e-d694051f3944

		changedProperty = Name

	measure 'Min Calendar Date' = MIN(Calendar[Date])
		formatString: General Date
		lineageTag: cf3ea559-508a-4e7a-8c6e-395b78665502

		changedProperty = Name

	measure 'Max Calendar Date' = MAX(Calendar[Date])
		formatString: General Date
		lineageTag: bb755680-4c7d-4152-8c80-8301c2974fdb

		changedProperty = Name

	measure 'Min Project Date' = MIN(Project[date_created])
		formatString: General Date
		lineageTag: 18a66ce3-5316-46d3-958e-2fb84d1975b5

		changedProperty = Name

	measure 'Max Project Date' = Max(Project[date_created])
		formatString: General Date
		lineageTag: 77a409ad-8e6f-4613-86a2-08d5a15774b6

		changedProperty = Name

	measure 'Revenue Converted' =
			
			VAR SelectedCurrency =
			    SELECTEDVALUE(destination_currency[currency_iso_code], "USD")
			
			RETURN
			    SUM(Project[amount_revenue]) *
			    SELECTEDVALUE(destination_currency[exchange_rate], 1)
		lineageTag: fd7c5543-8146-4e19-8208-4d5a99d31e6c

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

	measure 'Running Sum Revenue' =
			
			CALCULATE(
			    [Project Revenue],
			    FILTER(
			        ALLSELECTED('Project'[date_promised_complete]),
			        'Project'[date_promised_complete] <= MAX('Project'[date_promised_complete])
			    )
			)
		lineageTag: 5c2edd7c-09b8-4154-8211-018feb253c28

		formatStringDefinition = [Destination Format]

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

